{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "config/**/*.ts",
    "content/**/*.ts",
    "lib/**/*.ts",
    "worker/**/*.ts",
    "next.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
