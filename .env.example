# Server-side email delivery for the appointment form.
RESEND_API_KEY=
APPOINTMENTS_FROM_EMAIL=Asentya Website <appointments@your-domain.com>
APPOINTMENTS_TO_EMAIL=admin@asentya.com

# Asentya article editor (server-side only).
# Generate the password hash and session secret with scripts/configure-cms.mjs.
CMS_ADMIN_EMAIL=admin@asentya.com
CMS_PASSWORD_HASH=
CMS_SESSION_SECRET=
# Fine-grained GitHub token: asentya repository only, Contents read/write.
CMS_GITHUB_TOKEN=
